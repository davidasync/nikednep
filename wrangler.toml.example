name = "nikednep"
main = "src/index.ts"
compatibility_date = "2026-09-01"

# Short links are served straight off workers.dev. To use your own domain, add it
# to Cloudflare and uncomment:
# routes = [{ pattern = "nkd.example.com", custom_domain = true }]

# The only store. KV expires keys itself, so there is no schema and no sweep.
# Create with: wrangler kv namespace create LINKS
[[kv_namespaces]]
binding = "LINKS"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# 20 creates per IP per minute. Free on every plan and costs no KV writes.
[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 20, period = 60 }

[observability]
enabled = true
