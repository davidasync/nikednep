name = "nikednep"
main = "src/index.ts"
compatibility_date = "2026-09-01"

# Short links are served straight off workers.dev. To use your own domain, add it
# to Cloudflare and uncomment:
# routes = [{ pattern = "nkd.example.com", custom_domain = true }]

# Origins a browser may call `POST /api/shorten` from, comma-separated. Unset
# allows no browser origin at all. Not a secret — it is public in the response
# headers — so it lives here rather than in `wrangler secret`.
[vars]
ALLOWED_ORIGINS = "https://davidasync.github.io,https://davidasync.is-a.dev,http://localhost:3000,http://127.0.0.1:3000"

# The only store. KV expires keys itself, so there is no schema and no sweep.
# Create with: wrangler kv namespace create LINKS
[[kv_namespaces]]
binding = "LINKS"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# 20 creates per IP per minute. Free on every plan and costs no KV writes.
[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 20, period = 60 }

# Explicitly empty, not merely absent. Omitting this leaves any previously
# deployed Cron Trigger running on Cloudflare, and there is no scheduled()
# handler left to answer it. Safe to delete once a deploy has cleared it.
[triggers]
crons = []

[observability]
enabled = true
